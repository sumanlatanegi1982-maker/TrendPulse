# BrightData API Key
# Get yours from: https://brightdata.com/cp/setting/users
BRIGHTDATA_API_KEY=your_api_key_here

# Cache Mode (set to true to use cached_data.json instead of calling API)
# false = live mode (calls BrightData API, uses credits)
# true  = cache mode (loads from cached_data.json, zero API calls)
USE_CACHED_DATA=false

# Flask Settings
FLASK_PORT=5000
FLASK_DEBUG=true
